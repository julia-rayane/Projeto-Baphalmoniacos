# Variáveis usadas SOMENTE pelos testes de unidade e de rotas (npm test).
# Não há segredos reais aqui, por isso este arquivo vai para o Git.
NODE_ENV=test
DATABASE_URL="file:./test.db"
JWT_SECRET="segredo-somente-para-testes-automatizados"
PORT=3001

# SMTP inalcançável de propósito: se algum teste esquecesse de substituir o envio,
# a conexão seria recusada na hora e nenhum e-mail real sairia.
EMAIL_HOST="127.0.0.1"
EMAIL_PORT=1
EMAIL_SECURE=false
EMAIL_USER="teste"
EMAIL_PASS="teste"
