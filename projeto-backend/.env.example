DATABASE_URL="file:./dev.db"
PORT=3000

# Segredo usado para assinar os tokens JWT (troque por um valor longo e aleatório)
JWT_SECRET="troque_por_um_segredo_longo_e_aleatorio"

# Configurações de E-mail (SMTP). Se EMAIL_USER/EMAIL_PASS ficarem vazios,
# o app usa uma conta de teste automática do Ethereal.
EMAIL_HOST="smtp.ethereal.email"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=""
EMAIL_PASS=""
