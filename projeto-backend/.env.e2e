# Variáveis usadas SOMENTE pelo teste de ponta a ponta (npm run e2e).
# O servidor é iniciado pelo Playwright com estes valores e com um banco descartável.
NODE_ENV=test
DATABASE_URL="file:./e2e.db"
JWT_SECRET="segredo-somente-para-testes-e2e"
PORT=3100

# SMTP inalcançável de propósito: o cadastro continua funcionando (o app captura a
# falha do envio), mas nenhum e-mail real é enviado e nenhuma conta Ethereal é criada.
EMAIL_HOST="127.0.0.1"
EMAIL_PORT=1
EMAIL_SECURE=false
EMAIL_USER="e2e"
EMAIL_PASS="e2e"

# Admin criado pelo global-setup do Playwright (o banco é recriado a cada execução)
E2E_ADMIN_EMAIL="admin-e2e@baphalmoniacos.test"
E2E_ADMIN_PASSWORD="admin-e2e-123"
