generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Categoria {
  id       Int       @id @default(autoincrement())
  nome     String
  produtos Produto[]
}

model Produto {
  id              Int       @id @default(autoincrement())
  nome            String    @unique
  descricao       String
  preco           Float
  foto            String
  id_categoria_fk Int
  categoria       Categoria @relation(fields: [id_categoria_fk], references: [id])
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("cliente") // "cliente" ou "admin"
  criadoEm  DateTime @default(now())
}
