generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Categoria {
  id       Int       @id @default(autoincrement())
  nome     String
  produtos Produto[]
}

model Produto {
  id              Int       @id @default(autoincrement())
  nome            String    @unique
  descricao       String
  preco           Float
  foto            String
  id_categoria_fk Int
  categoria       Categoria @relation(fields: [id_categoria_fk], references: [id])
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  role     String   @default("cliente") // "cliente" ou "admin"
  criadoEm DateTime @default(now())
  image    Image? // no máximo UMA imagem (avatar) por usuário
}

// Arquivo enviado pelo usuário. "usuarioId @unique" garante 1 registro por usuário:
// um novo envio atualiza o caminho (upsert) em vez de criar um segundo registro.
model Image {
  id        Int     @id @default(autoincrement())
  path      String // caminho público, ex.: /imgs/profile/<hash>.png
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId Int     @unique
}
